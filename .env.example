# EventeIA — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA commite valores reais. Segredos seguem .context/SECURITY.md.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Login com Google (Supabase Auth OAuth) — ver docs/GOOGLE-LOGIN.md
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Asaas — sandbox por padrão (https://sandbox.asaas.com/api/v3); production → https://api.asaas.com/v3
ASAAS_ENVIRONMENT="sandbox"
# Override opcional da base (deixe vazio para usar ASAAS_ENVIRONMENT)
ASAAS_API_URL=""
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Evolution API (WhatsApp)
# Fallback temporário ?token= (webhook global da Evolution não envia headers). "false" desliga.
# WhatsApp Cloud API (Meta) — canal primário (número da EventeIA). Ver docs/WHATSAPP-CLOUD.md.
# Placeholders: NUNCA versione valores reais.

# Comercial
B2C_TICKET_PRICE_CENTS="9700"
# Oferta de boas-vindas (R$ 47, 24h): salt do HMAC de IP/aparelho (LGPD — IP bruto nunca é gravado).
# Vazio = oferta desligada (falha fechada). Mínimo 16 caracteres.
WELCOME_HASH_SALT=""

# Motor financeiro
ENGINE_TIMEZONE="America/Sao_Paulo"

# Agente Orçamentista
# Sessão conectada durante toda a coleta: até 5 cotações/categoria ou 24h (padrão; máx 2880).

# DeepSeek (extração de orçamentos). Sem chave ⇒ mock local.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Cérebro primário. "deepseek-flash" = DeepSeek-V4.1-Flash-1017 (api-docs.deepseek.com). DEEPSEEK_MOCK=1 simula sem rede.
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_MOCK=""

# E-mail (Resend). Fora de produção ou sem chave ⇒ mock (loga com e-mail mascarado).
RESEND_API_KEY=""
EMAIL_FROM="EventeIA <nao-responda@seu-dominio.com>"
# Central de atendimento: recebe alerta de chamados (problema) e urgentes
SUPPORT_ADMIN_EMAIL=""
EMAIL_MOCK=""

# --- Descoberta automática de fornecedores (Fase 2) ---
# Ordem de prioridade dos provedores: grok,nim,overpass,mock
DISCOVERY_PROVIDERS=
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Fallback (sem busca ao vivo: só estrutura/valida candidatos do Overpass)
NVIDIA_NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Orçamento diário de chamadas Grok e % a partir do qual troca para o NIM
XAI_DAILY_BUDGET=200
XAI_USAGE_SWITCH_PCT=25
DISCOVERY_MAX_CALLS_PER_EVENT=40
DISCOVERY_DAILY_CALL_CAP=300
# Segredo do POST /api/internal/suppliers/ingest (>= 32 chars; header x-ingest-secret)
DISCOVERY_INGEST_SECRET=
# true = nunca envia WhatsApp (homologação)
DISCOVERY_DRY_RUN=false

# --- Roteador de LLM (lib/ai/router.ts) — preços por 1M tokens em micro-USD ---
AI_PRICE_NIM_IN_PER_1M=100000
AI_PRICE_NIM_OUT_PER_1M=400000
AI_PRICE_GROK_IN_PER_1M=3000000
AI_PRICE_GROK_OUT_PER_1M=15000000
AI_PRICE_DEEPSEEK_IN_PER_1M=300000
AI_PRICE_DEEPSEEK_OUT_PER_1M=1200000
AI_GROK_BOOTSTRAP_MICROUSD=200000
AI_GROK_SEARCH_CALL_MICROUSD=30000
AI_USE_DEEPSEEK=true

# Painel financeiro ADMIN (opcionais). Preços em micro-USD; a tabela pricing_rates do admin tem prioridade.
# FINANCE_PRICES_JSON={"deepseek.in_miss.offpeak":150000,"search.per_1k":750000}
# Câmbio padrão (micro-BRL por US$ 1) até o admin lançar fx_rates. 5600000 = R$ 5,60
FINANCE_FX_BRL_PER_USD_MICRO=

# SEO: URL canônica pública e chave IndexNow (8-128 chars [a-zA-Z0-9-]).
NEXT_PUBLIC_SITE_URL=
INDEXNOW_KEY=

# Provedor de imagem (modelslab | nvidia) e modelo NVIDIA
IMAGE_PROVIDER=modelslab
NVIDIA_NIM_API_KEY=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux-3-image-klein
