# EventeIA — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA commite valores reais. Segredos seguem .context/SECURITY.md.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Asaas — sandbox por padrão (https://sandbox.asaas.com/api/v3); production → https://api.asaas.com/v3
ASAAS_ENVIRONMENT="sandbox"
# Override opcional da base (deixe vazio para usar ASAAS_ENVIRONMENT)
ASAAS_API_URL=""
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Evolution API (WhatsApp)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="EventeIA"
EVOLUTION_WEBHOOK_TOKEN=""

# Comercial
B2C_TICKET_PRICE_CENTS="9700"

# Motor financeiro
ENGINE_TIMEZONE="America/Sao_Paulo"

# Agente Orçamentista
WHATSAPP_MIN_INTERVAL_SECONDS="60"
WHATSAPP_CREDENTIALS_KEY=""
# Sessão conectada durante toda a coleta: até 5 cotações/categoria ou 48h (máx 2880).
WHATSAPP_COLLECTION_WINDOW_MINUTES="2880"
WHATSAPP_PROSPECTING_CONCURRENCY="25"

# DeepSeek (extração de orçamentos). Sem chave ⇒ mock local.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Cérebro primário. "deepseek-flash" = DeepSeek-V4.1-Flash-1017 (api-docs.deepseek.com). DEEPSEEK_MOCK=1 simula sem rede.
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_MOCK=""

# E-mail (Resend). Fora de produção ou sem chave ⇒ mock (loga com e-mail mascarado).
RESEND_API_KEY=""
EMAIL_FROM="EventeIA <nao-responda@seu-dominio.com>"
EMAIL_MOCK=""

# --- Descoberta automática de fornecedores (Fase 2) ---
# Ordem de prioridade dos provedores: grok,nim,overpass,mock
DISCOVERY_PROVIDERS=
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Fallback (sem busca ao vivo: só estrutura/valida candidatos do Overpass)
NVIDIA_NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Orçamento diário de chamadas Grok e % a partir do qual troca para o NIM
XAI_DAILY_BUDGET=200
XAI_USAGE_SWITCH_PCT=25
DISCOVERY_MAX_CALLS_PER_EVENT=40
DISCOVERY_DAILY_CALL_CAP=300
# Segredo do POST /api/internal/suppliers/ingest (>= 32 chars; header x-ingest-secret)
DISCOVERY_INGEST_SECRET=
# true = nunca envia WhatsApp (homologação)
DISCOVERY_DRY_RUN=false
WHATSAPP_DAILY_FIRST_CONTACTS=50

# --- Roteador de LLM (lib/ai/router.ts) — preços por 1M tokens em micro-USD ---
AI_PRICE_NIM_IN_PER_1M=100000
AI_PRICE_NIM_OUT_PER_1M=400000
AI_PRICE_GROK_IN_PER_1M=3000000
AI_PRICE_GROK_OUT_PER_1M=15000000
AI_PRICE_DEEPSEEK_IN_PER_1M=300000
AI_PRICE_DEEPSEEK_OUT_PER_1M=1200000
AI_GROK_BOOTSTRAP_MICROUSD=200000
AI_GROK_SEARCH_CALL_MICROUSD=30000
AI_USE_DEEPSEEK=true
