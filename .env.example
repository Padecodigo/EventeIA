# EventeIA — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA commite valores reais. Segredos seguem .context/SECURITY.md.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Asaas (sandbox)
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Evolution API (WhatsApp)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="EventeIA"
EVOLUTION_WEBHOOK_TOKEN=""

# Comercial
B2C_TICKET_PRICE_CENTS="9700"

# Motor financeiro
ENGINE_TIMEZONE="America/Sao_Paulo"

# Agente Orçamentista
WHATSAPP_MIN_INTERVAL_SECONDS="60"
WHATSAPP_CREDENTIALS_KEY=""
