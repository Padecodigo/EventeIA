{
  "root": true,
  "ignorePatterns": ["node_modules/**", ".next/**", "coverage/**", "supabase/**", "public/**", "**/*.mjs"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": ["./tsconfig.json"],
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "next/core-web-vitals",
    "next/typescript",
    "plugin:@typescript-eslint/strict",
    "plugin:@typescript-eslint/recommended-type-checked",
    "prettier"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/explicit-module-boundary-types": "error",
    "@typescript-eslint/no-floating-promises": "error",
    "@typescript-eslint/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "attributes": false } }
    ],
    "@typescript-eslint/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ],
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ],
    "@typescript-eslint/switch-exhaustiveness-check": "error",
    "@typescript-eslint/no-non-null-assertion": "warn",
    "@typescript-eslint/require-await": "error",
    "@typescript-eslint/await-thenable": "error",
    "@typescript-eslint/no-empty-function": "error",
    "@typescript-eslint/restrict-template-expressions": [
      "error",
      { "allowNumber": true }
    ],

    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error",
    "no-implicit-globals": "error",

    "react/no-danger": "error",
    "react/jsx-no-target-blank": ["error", { "allowReferrer": false }],
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error",

    "import/order": [
      "warn",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          ["parent", "sibling", "index"]
        ],
        "pathGroups": [
          { "pattern": "next/**", "group": "external", "position": "before" },
          { "pattern": "@/**", "group": "internal" }
        ],
        "pathGroupsExcludedImportTypes": ["builtin"],
        "newlines-between": "always",
        "alphabetize": { "order": "asc", "caseInsensitive": true }
      }
    ]
  },
  "overrides": [
    {
      "files": ["lib/engine/**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Motor determinístico: Math.random é proibido. Injete variação pelos parâmetros de entrada."
          },
          {
            "object": "Date",
            "property": "now",
            "message": "Motor determinístico: Date.now é proibido. Receba 'now' pela entrada."
          },
          {
            "object": "crypto",
            "property": "randomUUID",
            "message": "Motor determinístico: crypto.randomUUID é proibido dentro de lib/engine."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["next", "next/*", "react", "react-dom", "@supabase/*", "bullmq", "ioredis", "node:*", "@asaas/*"],
                "message": "O motor financeiro deve depender apenas de seus próprios módulos relativos (sem framework, sem I/O)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}"],
      "rules": {
        "@typescript-eslint/explicit-module-boundary-types": "off"
      }
    },
    {
      "files": ["scripts/**/*.ts", "workers/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "tests/**/*.ts"],
      "rules": {
        "@typescript-eslint/explicit-module-boundary-types": "off",
        "@typescript-eslint/no-non-null-assertion": "off",
        "no-console": "off",
        "@typescript-eslint/unbound-method": "off"
      }
    },
    {
      "files": ["*.config.{js,mjs,ts}", "next.config.{js,mjs}"],
      "rules": {
        "@typescript-eslint/no-var-requires": "off",
        "@typescript-eslint/explicit-module-boundary-types": "off",
        "no-console": "off"
      }
    }
  ]
}
