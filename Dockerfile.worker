# syntax=docker/dockerfile:1.7
# EventeIA — imagem do WORKER (jobs BullMQ). A base é mantida por enquanto;
# nenhuma automação de navegador é usada.
ARG PLAYWRIGHT_VERSION=1.64.1
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-jammy

WORKDIR /app
ENV NODE_ENV=production

# Node >= 25 (imagem Playwright) não traz mais o corepack embutido: instala via npm (--force: a imagem já tem /usr/bin/yarn).
RUN (command -v corepack >/dev/null || npm install -g --force corepack@latest) && corepack enable

# Só manifests → cache de camada estável (mesmo padrão do Dockerfile principal).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --config.strict-dep-builds=false

# Código do worker + lib (executado via tsx; Playwright já vem na imagem base).
COPY tsconfig.json tsconfig.workers.json ./
COPY lib ./lib
COPY workers ./workers


# tsx precisa do tsconfig.workers.json (stub de `server-only`); sem isso o
# worker cai no boot com "This module cannot be imported from a Client Component".
ENV TSX_TSCONFIG_PATH=tsconfig.workers.json

CMD ["pnpm", "exec", "tsx", "workers/index.ts"]
