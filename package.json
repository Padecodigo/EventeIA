{
  "name": "eventeia",
  "version": "0.1.0",
  "private": true,
  "description": "EventeIA — inteligência de custos e cotações para eventos.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "supabase test db",
    "knip": "knip",
    "lighthouse": "pnpm dlx @lhci/cli@0.14.x autorun",
    "workers": "tsx --env-file=.env.local --tsconfig tsconfig.workers.json workers/index.ts",
    "gen:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "simulate:webhook": "tsx --env-file=.env.local scripts/simulate-webhook.ts",
    "testimonials:publish": "tsx --env-file=.env.local scripts/publish-testimonial.ts",
    "demo:seed": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "e2e:local": "tsx --env-file=.env.local scripts/e2e-local.ts",
    "seo:indexnow": "tsx --env-file=.env.local scripts/indexnow-ping.ts",
    "geo:municipios": "tsx scripts/gen-municipios.ts",
    "build:workers": "esbuild workers/index.ts --bundle --platform=node --target=node20 --format=cjs --tsconfig=tsconfig.workers.json --outfile=dist/workers.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.49.0",
    "bullmq": "^5.44.0",
    "ioredis": "^5.6.0",
    "next": "^15.2.0",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "knip": "^5.45.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
