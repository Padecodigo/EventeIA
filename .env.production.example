# EventeIA — PRODUÇÃO. Copie os valores para as variáveis do Coolify
# (ou para .env.production no servidor, chmod 600). NUNCA commite valores reais.

# --- Domínios (Cloudflare → Traefik) ---
APP_DOMAIN=app.eventeia.com.br
EVOLUTION_DOMAIN=api.whatsapp.eventeia.com.br
# letsencrypt (padrão Coolify) | vazio se usar Cloudflare Origin Certificate
TRAEFIK_CERTRESOLVER=letsencrypt

# --- App ---
NEXT_PUBLIC_APP_URL=https://app.eventeia.com.br
LOG_LEVEL=info

# --- Supabase Cloud ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Redis (container interno; senha forte: openssl rand -hex 32) ---
REDIS_PASSWORD=<redis-password>
# Montado pelo compose a partir de REDIS_PASSWORD:
# REDIS_URL=redis://:<redis-password>@redis:6379/0

# --- Asaas ---
# trocar para production no go-live
ASAAS_ENVIRONMENT=sandbox
# vazio = derivado de ASAAS_ENVIRONMENT
ASAAS_API_URL=
ASAAS_API_KEY=<asaas-api-key>
ASAAS_WEBHOOK_TOKEN=<asaas-webhook-token>

# --- Evolution API v2 ---
# URL interna fixada no compose:
# EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=<evolution-global-api-key>
EVOLUTION_INSTANCE=<instance-name>
EVOLUTION_WEBHOOK_TOKEN=<evolution-webhook-token>
EVOLUTION_DB_PASSWORD=<evolution-db-password>

# --- Comercial / motor ---
B2C_TICKET_PRICE_CENTS=<price-in-cents>
ENGINE_TIMEZONE=America/Sao_Paulo

# --- Agente Orçamentista (WhatsApp) ---
WHATSAPP_MIN_INTERVAL_SECONDS=<seconds>
WHATSAPP_CREDENTIALS_KEY=<32-byte-hex-key>
WHATSAPP_COLLECTION_WINDOW_MINUTES=<minutes>
WHATSAPP_PROSPECTING_CONCURRENCY=<n>

# --- LLM ---
DEEPSEEK_API_KEY=<deepseek-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MOCK=false
# Roteador xAI Grok + NVIDIA NIM (ainda não lidos no main; nomes reservados
# para o branch do roteador — ajuste se o código usar outros nomes)
XAI_API_KEY=<xai-key>
NVIDIA_NIM_API_KEY=<nvidia-nim-key>
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- E-mail (Resend) ---
RESEND_API_KEY=<resend-key>
EMAIL_FROM=EventeIA <no-reply@eventeia.com.br>
EMAIL_MOCK=false

# --- Demo: SEMPRE desligado em produção (forçado false no compose) ---
# DEMO_LOGIN_ENABLED / DEMO_LOGIN_SECRET / DEMO_*_PASSWORD não devem ser definidos.

# ---------------------------------------------------------------------------
# Roteador de IA (DeepSeek → Grok/xAI → NVIDIA NIM). Valores reais só no host.
# ---------------------------------------------------------------------------
AI_USE_DEEPSEEK=true
XAI_MODEL=
XAI_USAGE_SWITCH_PCT=25
XAI_DAILY_BUDGET=
NIM_MODEL=
# Preços (micro-USD por 1M tokens); vazio = padrão do código.
AI_PRICE_DEEPSEEK_IN_PER_1M=
AI_PRICE_DEEPSEEK_OUT_PER_1M=
AI_PRICE_GROK_IN_PER_1M=
AI_PRICE_GROK_OUT_PER_1M=
AI_PRICE_NIM_IN_PER_1M=
AI_PRICE_NIM_OUT_PER_1M=
AI_GROK_BOOTSTRAP_MICROUSD=
AI_GROK_SEARCH_CALL_MICROUSD=

# Descoberta de fornecedores
DISCOVERY_PROVIDERS=
DISCOVERY_DRY_RUN=true
DISCOVERY_DAILY_CALL_CAP=
DISCOVERY_MAX_CALLS_PER_EVENT=
DISCOVERY_INGEST_SECRET=

# Financeiro (admin)
FINANCE_PRICES_JSON=
FINANCE_FX_BRL_PER_USD_MICRO=

# WhatsApp (janelas e limites)
WHATSAPP_DAILY_FIRST_CONTACTS=
