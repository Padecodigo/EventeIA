# EventeIA — PRODUÇÃO. Copie os valores para as variáveis do Coolify
# (ou para .env.production no servidor, chmod 600). NUNCA commite valores reais.

# --- Domínios (Cloudflare → Traefik) ---
APP_DOMAIN=eventeia.com.br
# letsencrypt (padrão Coolify) | vazio se usar Cloudflare Origin Certificate
TRAEFIK_CERTRESOLVER=letsencrypt

# --- App ---
NEXT_PUBLIC_APP_URL=https://eventeia.com.br
LOG_LEVEL=info

# --- Supabase Cloud ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Login com Google — no Supabase Cloud configure em Authentication → Providers → Google
# (ver docs/GOOGLE-LOGIN.md). Usadas pelo CLI/self-host em supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-oauth-client-secret>

# --- Redis (container interno; senha forte: openssl rand -hex 32) ---
REDIS_PASSWORD=<redis-password>
# Montado pelo compose a partir de REDIS_PASSWORD:
# REDIS_URL=redis://:<redis-password>@redis:6379/0

# --- Asaas ---
# trocar para production no go-live
ASAAS_ENVIRONMENT=sandbox
# vazio = derivado de ASAAS_ENVIRONMENT
ASAAS_API_URL=
ASAAS_API_KEY=<asaas-api-key>
ASAAS_WEBHOOK_TOKEN=<asaas-webhook-token>

# --- Evolution API v2 ---
# URL interna fixada no compose:
# EVOLUTION_API_URL=http://evolution-api:8080
# Fallback temporário ?token= (webhook global da Evolution não envia headers). "false" desliga.
# WhatsApp Cloud API (Meta) — ver docs/WHATSAPP-CLOUD.md

# --- Comercial / motor ---
B2C_TICKET_PRICE_CENTS=<price-in-cents>
# Oferta de boas-vindas: salt do HMAC de IP/aparelho (LGPD). Obrigatório para ligar a oferta (>=16 chars).
WELCOME_HASH_SALT=<random-32-bytes-hex>
ENGINE_TIMEZONE=America/Sao_Paulo

# --- Agente Orçamentista (WhatsApp) ---

# --- LLM ---
DEEPSEEK_API_KEY=<deepseek-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MOCK=false
# Roteador xAI Grok + NVIDIA NIM (ainda não lidos no main; nomes reservados
# para o branch do roteador — ajuste se o código usar outros nomes)
XAI_API_KEY=<xai-key>
NVIDIA_NIM_API_KEY=<nvidia-nim-key>
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- E-mail (Resend) ---
RESEND_API_KEY=<resend-key>
EMAIL_FROM=EventeIA <no-reply@eventeia.com.br>
# Central de atendimento: recebe alerta de chamados (problema) e urgentes
SUPPORT_ADMIN_EMAIL=suporte@eventeia.com.br
EMAIL_MOCK=false

# --- Demo: SEMPRE desligado em produção (forçado false no compose) ---
# DEMO_LOGIN_ENABLED / DEMO_LOGIN_SECRET / DEMO_*_PASSWORD não devem ser definidos.

# ---------------------------------------------------------------------------
# Roteador de IA (DeepSeek → Grok/xAI → NVIDIA NIM). Valores reais só no host.
# ---------------------------------------------------------------------------
AI_USE_DEEPSEEK=true
XAI_MODEL=
XAI_USAGE_SWITCH_PCT=25
XAI_DAILY_BUDGET=
NIM_MODEL=
# Preços (micro-USD por 1M tokens); vazio = padrão do código.
AI_PRICE_DEEPSEEK_IN_PER_1M=
AI_PRICE_DEEPSEEK_OUT_PER_1M=
AI_PRICE_GROK_IN_PER_1M=
AI_PRICE_GROK_OUT_PER_1M=
AI_PRICE_NIM_IN_PER_1M=
AI_PRICE_NIM_OUT_PER_1M=
AI_GROK_BOOTSTRAP_MICROUSD=
AI_GROK_SEARCH_CALL_MICROUSD=

# Meta — Instagram Direct + Messenger (respostas, janela 24h; NÃO faz abordagem fria)
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ID=
META_API_VERSION=v26.0
# graph.facebook.com (Facebook Login) | graph.instagram.com (Instagram Login)
META_API_HOST=graph.facebook.com

# Publicação Instagram: graph (API oficial) | browser (sessão logada, grokbot-style).
# O browser roda no container do worker e exige Chromium (mcr.microsoft.com/playwright).
INSTAGRAM_PROVIDER=graph
# Caminho do storageState (cookies) — monte um volume persistente no worker.
INSTAGRAM_SESSION_FILE=/data/instagram-session.json
INSTAGRAM_BROWSER_HEADLESS=true

# Prospecção (posts de isca)
META_PROSPECT_KEYWORD=cotação
MODELSLAB_API_KEY=
REQUIRE_APPROVAL=true
MAX_POSTS_PER_DAY=2
MAX_TAGS_PER_POST=8
MIN_POST_INTERVAL_MINUTES=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Descoberta de fornecedores
# Ordem = prioridade. "overpass" (OSM) é grátis e passa pelo DeepSeek para
# relevância; "serper" é pago e cai para a DeepSeek Search API quando os
# créditos ficam abaixo de SERPER_MIN_CREDITS. Evite "google_places": o Serper
# já entrega os mesmos dados do Google Maps por ~1/20 do preço.
DISCOVERY_PROVIDERS=overpass,serper
DISCOVERY_DRY_RUN=true
DISCOVERY_DAILY_CALL_CAP=
DISCOVERY_MAX_CALLS_PER_EVENT=
DISCOVERY_INGEST_SECRET=

# Financeiro (admin)
FINANCE_PRICES_JSON=
FINANCE_FX_BRL_PER_USD_MICRO=

# WhatsApp (janelas e limites)

# SEO: URL canônica pública e chave IndexNow (8-128 chars [a-zA-Z0-9-]).
NEXT_PUBLIC_SITE_URL=
INDEXNOW_KEY=

# Provedor de imagem (modelslab | nvidia) e modelo NVIDIA
IMAGE_PROVIDER=modelslab
NVIDIA_IMAGE_MODEL=black-forest-labs/flux-3-image-klein

# TTL da sessão (minutos) — curto por padrão
SESSION_MAX_AGE_MINUTES=120
